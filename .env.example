# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. Comments below note which SPEC.md stage
# introduces each variable and whether its shape is still TBD.

# --- Database (Stage 0/1) ---
# Port 5433, not 5432 — see docker-compose.yml: 5432 is the single most
# likely port to already be taken by a locally-installed Postgres (it was,
# on the machine this was written on), so the container's host-side port
# is remapped. This only matters for host tools (this value, psql, a GUI
# client) — the app talks to the db container internally as "db:5432"
# regardless, via docker-compose.yml's own override of this variable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/political_watchtower

# --- Admin GUI (Stage 4) ---
# Single admin credential + session cookie, per Stage 4's auth decision
# (cross-cutting decision under "Key decisions to confirm").
ADMIN_CREDENTIAL=
SESSION_SECRET=

# --- Government data APIs ---
# Pilot state's legislature API key, if the API turns out to require one —
# TBD, pending Stage 3's research task into what it actually exposes.
STATE_API_KEY=
# Congress.gov API key (Stage 15 — US Congress expansion). Free, but
# requires requesting a key: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# --- LLM (Stage 10 claim extraction, Stage 12 AI summaries) ---
# Provider/model not yet finalized — "free/near-free" budget decision is
# still open (see Stage 10/12 "Key decisions to confirm"). Placeholder
# name; rename once a provider is settled on.
LLM_API_KEY=

# --- Social platform oEmbed (Stage 8) ---
# Only needed if/when a given platform's oEmbed requires app-level auth.
# X (Twitter): public oEmbed generally doesn't require a key — leave blank
# unless a specific integration needs one.
X_API_BEARER_TOKEN=
# Facebook/Instagram oEmbed requires an app access token under Meta's
# current API.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
